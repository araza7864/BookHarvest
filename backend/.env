# Use SQLite (no setup). For PostgreSQL instead, set:
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/seamlessbook
DATABASE_URL=sqlite+aiosqlite:///./seamlessbook.db
SECRET_KEY=your-secret-key-change-in-production
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key
ENVIRONMENT=development